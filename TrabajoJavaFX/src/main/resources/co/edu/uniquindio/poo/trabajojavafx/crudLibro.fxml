<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600.0" prefWidth="1060.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.trabajojavafx.viewController.LibroViewController">
    <top>
        <VBox spacing="10.0" styleClass="header" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label styleClass="title" text="Catálogo de la Biblioteca" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#onVolver" text="Volver al menú" />
                    </children>
                </HBox>
                <TextField fx:id="txtBuscar" promptText="Buscar por ISBN, título o autor..." />
            </children>
            <padding>
                <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
            </padding>
        </VBox>
    </top>
    <left>
        <VBox prefWidth="310.0" spacing="14.0" styleClass="panel" BorderPane.alignment="CENTER">
            <children>
                <Label styleClass="subtitle" text="Datos del libro" />
                <GridPane hgap="8.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="70.0" prefWidth="80.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="120.0" />
                    </columnConstraints>
                    <children>
                        <Label text="ISBN:" />
                        <TextField fx:id="txtIsbn" promptText="978-0-13-468599-1" GridPane.columnIndex="1" />
                        <Label text="Título:" GridPane.rowIndex="1" />
                        <TextField fx:id="txtTitulo" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label text="Autor:" GridPane.rowIndex="2" />
                        <TextField fx:id="txtAutor" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                        <Label text="Año:" GridPane.rowIndex="3" />
                        <TextField fx:id="txtAnio" promptText="Ej: 2018" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                        <Label text="Categoría:" GridPane.rowIndex="4" />
                        <ComboBox fx:id="cmbCategoria" maxWidth="1.7976931348623157E308" promptText="Seleccione..." GridPane.columnIndex="1" GridPane.rowIndex="4" />
                        <CheckBox fx:id="chkDisponible" mnemonicParsing="false" selected="true" text="Disponible para préstamo" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                    </children>
                </GridPane>
                <GridPane hgap="8.0" vgap="8.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                    </columnConstraints>
                    <children>
                        <Button fx:id="btnAgregar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onAgregar" styleClass="btn-primario" text="Agregar" />
                        <Button fx:id="btnActualizar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onActualizar" text="Actualizar" GridPane.columnIndex="1" />
                        <Button fx:id="btnEliminar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onEliminar" styleClass="btn-peligro" text="Eliminar" GridPane.rowIndex="1" />
                        <Button fx:id="btnLimpiar" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onLimpiar" text="Limpiar" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    </children>
                </GridPane>
            </children>
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>
        </VBox>
    </left>
    <center>
        <TableView fx:id="tblLibros" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="tbcIsbn" prefWidth="120.0" text="ISBN" />
                <TableColumn fx:id="tbcTitulo" prefWidth="200.0" text="Título" />
                <TableColumn fx:id="tbcAutor" prefWidth="150.0" text="Autor" />
                <TableColumn fx:id="tbcAnio" prefWidth="60.0" text="Año" />
                <TableColumn fx:id="tbcCategoria" prefWidth="110.0" text="Categoría" />
                <TableColumn fx:id="tbcDisponible" prefWidth="90.0" text="Disponible" />
            </columns>
            <BorderPane.margin>
                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
            </BorderPane.margin>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="statusbar" BorderPane.alignment="CENTER">
            <children>
                <Label fx:id="lblEstado" maxWidth="1.7976931348623157E308" styleClass="estado-info" text="Listo." HBox.hgrow="ALWAYS" />
                <Label fx:id="lblTotal" text="Mostrando 0 de 0 libros" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
